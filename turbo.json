{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PRIVATE_STRIPE_API_KEY",
    "PUBLIC_API_URL",
    "INTERNAL_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "dist/**", "build/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
