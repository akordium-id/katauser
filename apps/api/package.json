{
  "name": "@katauser/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./app": {
      "import": "./src/app.ts",
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "@katauser/db": "workspace:*",
    "@katauser/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@katauser/tsconfig": "workspace:*",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vitest": "^3.0.7"
  }
}
