# Katauser Environment Variables

# Web & API Ports / URLs
PUBLIC_API_URL="http://localhost:3000"
INTERNAL_API_URL="http://localhost:3000"
PUBLIC_MAIN_DOMAIN="localhost"

# Database & Cache
DATABASE_URL="postgresql://katauser:supersecret@localhost:5432/katauser_dev"
REDIS_URL="redis://localhost:6379"

# Auth & Security
JWT_SECRET="super_secret_jwt_key_at_least_32_characters_long"

# AI Juno Agent (Optional)
# OPENAI_API_KEY="sk-proj-..."

# Stripe Settings (Optional)
PRIVATE_STRIPE_API_KEY="REPLACE_ME"

# Email Settings (Optional)
# PRIVATE_ADMIN_EMAIL="admin@example.com"
# PRIVATE_FROM_ADMIN_EMAIL="no-reply@example.com"
# PRIVATE_RESEND_API_KEY="re_..."
